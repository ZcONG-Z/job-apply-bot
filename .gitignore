# ============================================================
#  个人数据 —— 绝对不能提交
#  这个项目会存储身份证号、手机号、家庭住址等敏感信息。
#  以下规则是安全边界，请勿删改。
# ============================================================
profile.json
profile.*.json
!profile.example.json

# 登录态（含 cookie / token）
.auth/
**/.auth/
storage_state*.json

# 简历原件与附件
inbox/
resumes/
files/

# 运行产物（截图里可能含真实表单内容）
runs/
artifacts/

# 台账
*.db
*.sqlite
*.sqlite3
ledger.db

# ============================================================
#  简历文件：默认忽略，只允许测试用的脱敏样本
# ============================================================
*.pdf
*.doc
*.docx
!tests/fixtures/sample-*.pdf
!tests/fixtures/sample-*.docx

# 护照/证件照等
*.jpg
*.jpeg
*.png
!docs/images/*.png
!*.svg

# ============================================================
#  Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
sdist/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ============================================================
#  环境变量与密钥
# ============================================================
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# ============================================================
#  编辑器 / 系统
# ============================================================
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ============================================================
#  Playwright / Node
# ============================================================
node_modules/
playwright-report/
test-results/
.playwright/

# ============================================================
#  其他
# ============================================================
*.log
!docs/**/*.log
tmp/
.cache/
